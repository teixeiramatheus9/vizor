{
  "name": "vizor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron . --no-sandbox --ozone-platform=x11",
    "test": "vitest run",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:remove": "node scripts/install-hooks.js --remove",
    "autostart:install": "node scripts/install-autostart.js",
    "autostart:remove": "node scripts/install-autostart.js --remove",
    "start:win": "electron .",
    "dist": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "author": "teixeiramatheus9 <teixeiramatheus9@users.noreply.github.com>",
  "license": "MIT",
  "description": "Gerente flutuante das sessões do Claude Code",
  "build": {
    "appId": "io.github.teixeiramatheus9.vizor",
    "productName": "Vizor",
    "asar": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableArgs": [
        "--no-sandbox",
        "--ozone-platform=x11"
      ],
      "maintainer": "teixeiramatheus9 <teixeiramatheus9@users.noreply.github.com>",
      "synopsis": "Gerente flutuante das sessões do Claude Code"
    },
    "deb": {
      "depends": [
        "xdotool"
      ],
      "fpm": [
        "--replaces",
        "claude-manager",
        "--conflicts",
        "claude-manager"
      ]
    },
    "rpm": {
      "depends": [
        "xdotool"
      ],
      "fpm": [
        "--replaces",
        "claude-manager"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "teixeiramatheus9",
      "repo": "vizor",
      "releaseType": "draft"
    },
    "extraResources": [
      {
        "from": "resources/gnome-extension",
        "to": "gnome-extension"
      }
    ]
  },
  "devDependencies": {
    "electron": "^42.9.3",
    "electron-builder": "^26.15.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "diff": "^8.0.4",
    "electron-updater": "^6.8.9",
    "unbzip2-stream": "^1.4.3"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.15"
  }
}
