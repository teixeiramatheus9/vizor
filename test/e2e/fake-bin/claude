#!/usr/bin/env node
// A stand-in for Claude Code in the end-to-end run: it registers like one,
// writes the plan the Vizor asked for and reports through the real hook.
// Approved (a line saying so arrives on the terminal), it ticks step one.
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const crypto = require('node:crypto');
const { spawn, spawnSync } = require('node:child_process');

// An automação's run (the Vizor sets VIZOR_AUTOMATION). What it does comes from
// $HOME/fake-auto.json, read on every run: { mode: 'ok' | 'sleep', delayMs, costUsd, result }.
// 'sleep' outlives any timeout and keeps a `sleep` child in the same process
// group; every pid goes to $HOME/fake-auto-runs.jsonl so a scenario can check
// nobody is left behind.
if (process.env.VIZOR_AUTOMATION) {
  let knob = {};
  try {
    knob = JSON.parse(fs.readFileSync(path.join(os.homedir(), 'fake-auto.json'), 'utf8'));
  } catch {
    // defaults
  }
  const sleeper = knob.mode === 'sleep' ? spawn('sleep', ['600'], { stdio: 'ignore' }) : null;
  fs.appendFileSync(path.join(os.homedir(), 'fake-auto-runs.jsonl'), `${JSON.stringify({ at: Date.now(), id: process.env.VIZOR_AUTOMATION, pid: process.pid, childPid: sleeper?.pid ?? null, args: process.argv.slice(2) })}\n`);
  setTimeout(() => {
    process.stdout.write(JSON.stringify({ type: 'result', subtype: 'success', is_error: false, result: knob.result ?? 'Tudo certo.', total_cost_usd: knob.costUsd ?? 0, duration_ms: 1000, num_turns: 1, session_id: crypto.randomUUID() }));
    process.exit(0);
  }, knob.mode === 'sleep' ? 600000 : (knob.delayMs ?? 0));
  // CommonJS allows a top-level return: nothing below is an automação's business.
  return;
}
// The app's own `claude -p` calls (the gerente's alerts) get an empty answer
// and never touch a folder.
if (process.argv.includes('-p') || process.argv.includes('--print') || process.env.VIZOR_INTERNAL) {
  process.stdout.write(JSON.stringify({ type: 'result', result: '', usage: { input_tokens: 0, output_tokens: 0 } }));
  process.exit(0);
}
const prompt = process.argv[2] ?? '';
const sessionId = crypto.randomUUID();
const cwd = process.cwd();
const home = os.homedir();
fs.mkdirSync(path.join(home, '.claude', 'sessions'), { recursive: true });
fs.writeFileSync(path.join(home, '.claude', 'sessions', `${process.pid}.json`), JSON.stringify({ pid: process.pid, sessionId, cwd, startedAt: Date.now(), kind: 'interactive' }));
const projectDir = path.join(home, '.claude', 'projects', cwd.replace(/[^A-Za-z0-9]/g, '-'));
fs.mkdirSync(projectDir, { recursive: true });
const transcript = path.join(projectDir, `${sessionId}.jsonl`);

const emit = (event) =>
  spawnSync(process.execPath, [process.env.VIZOR_E2E_HOOK], {
    input: JSON.stringify({ session_id: sessionId, cwd, transcript_path: transcript, ...event }),
    env: process.env,
  });
const say = (text) => {
  fs.appendFileSync(transcript, `${JSON.stringify({ type: 'assistant', sessionId, message: { role: 'assistant', content: [{ type: 'text', text }] } })}\n`);
  process.stdout.write(`${text}\r\n`);
};
const planFile = path.join(cwd, '.vizor', `plano-${prompt.match(/issue #(\d+)/)?.[1] ?? 'x'}.md`);
const steps = ['Ler a issue', 'Criar o menu', 'Testar o menu'];
const writePlan = (done) => {
  fs.mkdirSync(path.dirname(planFile), { recursive: true });
  fs.writeFileSync(planFile, `${steps.map((step, index) => `- [${index < done ? 'x' : ' '}] ${step}`).join('\n')}\nVizor-plano: src/menu.js\n`);
};

// The contract flow (issue #149): the plan comes with a "## Contrato", then, once
// the contract is approved, the tests and their command, then one step per ok
// with its porquê. Everything it does comes from a line typed on its terminal.
if (/issue #149\b/.test(prompt)) {
  const T = { cases: ['clicar no ícone → abre o menu', 'clicar fora → fecha o menu'], steps: ['Criar o menu', 'Ligar o clique', 'Testar o menu'] };
  const testFile = path.join(cwd, 'test', 'x.test.js');
  const mark = (done, withTests) => {
    fs.mkdirSync(path.dirname(planFile), { recursive: true });
    const steps = T.steps.map((step, index) => `- [${index < done ? 'x' : ' '}] ${step}${index < done ? `\n  porquê: o passo ${index + 1} existe pra ${step.toLowerCase()}.` : ''}`).join('\n');
    const files = withTests ? 'Vizor-contrato: test/x.test.js\nVizor-teste: node test/x.test.js\n' : '';
    fs.writeFileSync(planFile, `# Menu de ação\n\n## Contrato\n${T.cases.map((item) => `- ${item}`).join('\n')}\n\n## Passos\n${steps}\n\n${files}Vizor-plano: src/x.js\n`);
  };
  const touched = (file) => emit({ hook_event_name: 'PostToolUse', tool_name: 'Write', tool_input: { file_path: file, content: 'x' }, tool_response: {} });
  const planWritten = () => emit({ hook_event_name: 'PostToolUse', tool_name: 'Write', tool_input: { file_path: planFile, content: 'plano' }, tool_response: {} });
  let done = 0;
  emit({ hook_event_name: 'UserPromptSubmit', prompt });
  mark(0, false);
  planWritten();
  say('Plano com contrato escrito. Espero seu ok.');
  emit({ hook_event_name: 'Stop' });
  let typedTask = '';
  process.stdin.setRawMode?.(true);
  process.stdin.on('data', async (chunk) => {
    fs.appendFileSync(path.join(home, 'claude-received.log'), chunk.toString());
    typedTask += chunk.toString();
    if (!typedTask.includes('\r')) return;
    const line = typedTask;
    typedTask = '';
    emit({ hook_event_name: 'UserPromptSubmit', prompt: line });
    if (/Contrato aprovado/.test(line)) {
      // Tests only: src/x.js does not exist yet, so they fail for the right reason.
      fs.mkdirSync(path.dirname(testFile), { recursive: true });
      fs.writeFileSync(testFile, [
        "const fs = require('node:fs');",
        "const path = require('node:path');",
        "// What a run of the tests does to the file: a locked test changing on disk.",
        "if (fs.existsSync(path.join(__dirname, '..', '.vizor', 'mutate'))) fs.appendFileSync(__filename, '\\n// touched by the run\\n');",
        "const { double } = require('../src/x.js');",
        "if (double(2) !== 4) throw new Error('double(2) should be 4');",
        '',
      ].join('\n'));
      touched(testFile);
      mark(0, true);
      planWritten();
      say('Testes escritos; falham porque src/x.js ainda não existe.');
    } else if (/Ok, segue/.test(line)) {
      done += 1;
      const y = path.join(cwd, 'src', 'y.js');
      fs.appendFileSync(y, `export const step${done} = ${done};\n`);
      if (done === 1) fs.writeFileSync(path.join(cwd, 'src', 'x.js'), 'exports.double = (n) => n * 2;\n');
      mark(done, true);
      planWritten();
      // The ticked step starts a run of the tests: when they rewrote the locked file, report.
      if (fs.existsSync(path.join(cwd, '.vizor', 'mutate'))) {
        for (let tries = 0; tries < 150 && !fs.readFileSync(testFile, 'utf8').includes('\n// touched by the run'); tries++) await new Promise((resolve) => setTimeout(resolve, 100));
      }
      say(`Passo ${done} feito.`);
    } else if (/Voltei os arquivos/.test(line)) {
      done = 0;
      mark(0, true);
      planWritten();
      say('Desmarquei os passos desfeitos.');
    } else return;
    emit({ hook_event_name: 'Stop' });
  });
  // CommonJS top-level return: the quick flow below is not this task's.
  return;
}

emit({ hook_event_name: 'UserPromptSubmit', prompt });
writePlan(0);
emit({ hook_event_name: 'PostToolUse', tool_name: 'Write', tool_input: { file_path: planFile, content: 'plano' }, tool_response: {} });
say('Plano escrito em .vizor/plano.md. Espero seu ok.');
emit({ hook_event_name: 'Stop' });

let typed = '';
process.stdin.setRawMode?.(true);
process.stdin.on('data', (chunk) => {
  // Everything the app types into this chat, for the scenarios to read back.
  fs.appendFileSync(path.join(home, 'claude-received.log'), chunk.toString());
  typed += chunk.toString();
  if (!typed.includes('\r')) return;
  const line = typed;
  typed = '';
  if (!/aprovado/i.test(line)) return;
  emit({ hook_event_name: 'UserPromptSubmit', prompt: line });
  writePlan(1);
  emit({ hook_event_name: 'PostToolUse', tool_name: 'Edit', tool_input: { file_path: planFile, old_string: '- [ ] Ler', new_string: '- [x] Ler' }, tool_response: {} });
  say('Passo 1 feito.');
  emit({ hook_event_name: 'Stop' });
});
